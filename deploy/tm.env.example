# Settings of one ToyMayhem deployment. Copy to /opt/toymayhem/tm.env on the VPS (the bootstrap script does this).
# This is the ONE place for the domain: hostnames in the compose file and the scripts are derived from TM_DOMAIN.
# Nothing secret in here, secrets are files under TM_SECRETS_DIR (see README.md).

# The domain, bought later. example.invalid can never resolve, so nothing goes live by accident.
TM_DOMAIN=example.invalid

# Image to run. The pipeline pushes ghcr.io/decompozed/tm_emresearch:sha-<commit> for every commit on main.
TM_IMAGE=ghcr.io/decompozed/tm_emresearch:main

# Staff login port 13001 and the commands that need it. Needs three more secrets (make-secrets.sh makes them).
TM_ENHANCED_SECURITY=true

# Mail for security alerts, only used with TM_ENHANCED_SECURITY=true. The defaults are derived from TM_DOMAIN.
# The mail password is the secret file email_token.
#TM_SMTP_SERVER=smtp://smtp.example.invalid:587
#TM_EMAIL_SENDER=toymayhem@example.invalid
#TM_EMAIL_USERNAME=toymayhem@example.invalid
#TM_SECURITY_NOTIFY=blue@example.invalid

# Host folders. Secrets: root only. Logs: readable by the group blueteam (created by the bootstrap script).
TM_SECRETS_DIR=/opt/toymayhem/secrets
TM_LOG_HOST_DIR=/srv/toymayhem/logs

# Where the schema file sits next to the compose file
TM_SCHEMA_SQL=./microvolts-db.sql

# Internal address of the game containers on the app network. Change only if 172.28.0.0/24 clashes with something.
TM_APP_SUBNET=172.28.0.0/24
TM_APP_IP=172.28.0.10

# Captcha of the website registration. The secret key is the file turnstile_secret. Keep "on" in production.
TM_TURNSTILE=on

# Rate limits of the account API per player address. Raise the registration limit for an event where many players share
# one school network (one public address), for example to 60.
TM_REGISTER_LIMIT_PER_HOUR=5
TM_LOGIN_LIMIT_PER_15MIN=10
TM_PASSWORD_LIMIT_PER_15MIN=5

# Client version the servers accept (X.X.X, one digit each)
TM_CLIENT_VERSION=0.0.3
