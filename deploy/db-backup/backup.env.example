# /etc/toymayhem/backup.env (mode 0600, owner root). Used by tm-backup.sh and tm-restore.sh.
# Cloudflare R2: bucket and an S3 API token that can only read and write objects in that one bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=toymayhem-backups

# Fingerprint of the backup PUBLIC key (gpg --fingerprint on your own machine). Put the exported public key in
# /etc/toymayhem/backup-public.asc. The private key never goes to the server.
GPG_RECIPIENT=

# Days to keep (the newest three copies are always kept)
KEEP_DAYS=14
